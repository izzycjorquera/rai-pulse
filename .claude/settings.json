{
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "$CLAUDE_PROJECT_DIR/.claude/hooks/session-start.sh"
          }
        ]
      }
    ]
  },
  "permissions": {
    "allow": [
      "Edit",
      "Write",
      "Bash(git status*)",
      "Bash(git diff*)",
      "Bash(git log*)",
      "Bash(git show*)",
      "Bash(git add*)",
      "Bash(git commit*)",
      "Bash(git push*)",
      "Bash(git pull*)",
      "Bash(git fetch*)",
      "Bash(git branch*)",
      "Bash(git checkout*)",
      "Bash(git stash*)",
      "Bash(git worktree*)",
      "Bash(git merge*)",
      "Bash(python3 *)",
      "Bash(kill %1)",
      "Bash(pkill -f \"http.server 8080\")",
      "Bash(pkill -f \"vite dev\")",
      "Bash(npm install *)",
      "Bash(npm run *)",
      "Bash(npm --version)",
      "Bash(bun --version)",
      "Bash(echo \"PID: $!\")",
      "Bash(curl *)",
      "Bash(disown)",
      "Bash(netstat -tlnp)",
      "Bash(cloudflared --version)",
      "Bash(ngrok version *)",
      "Bash(npx eslint *)",
      "Bash(npx prettier *)",
      "Bash(bash)",
      "Bash(tar xzf *)",
      "Bash(gh pr *)",
      "Bash(gh auth *)",
      "Skill(update-config)",
      "Skill(update-config:*)",
      "WebSearch"
    ],
    "ask": [
      "Bash(git push --force*)",
      "Bash(git push -f*)",
      "Bash(git push * --force*)",
      "Bash(git push * -f*)",
      "Bash(git reset --hard*)",
      "Bash(git checkout .)",
      "Bash(git checkout . *)",
      "Bash(git restore*)",
      "Bash(git clean -f*)",
      "Bash(git branch -D*)"
    ]
  }
}
