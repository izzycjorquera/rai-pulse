# Copy this file to .env and fill in real values, then restart `vite dev`.

# Required — powers the article feed on the homepage.
# Get a free key at https://newsapi.org/register
NEWSAPI_KEY=

# Optional — powers AI curation/ranking and the weekly intro paragraph.
# Without it the site still runs but skips curation (see README).
# Get a key at https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=
